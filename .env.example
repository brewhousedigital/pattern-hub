# Cloudflare Turnstile - https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key is server-only - set this in Netlify dashboard, NOT in .env.local
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# Shared secret every public submission function checks (submit-pattern,
# submit-gallery, submit-report, submit-contact, submit-content-report,
# edit-pattern-submission, delete-gallery, update-gallery) - server-only, set
# this in the Netlify dashboard, NOT in .env.local
# FORM_SUBMISSION_PASSWORD=your_form_submission_password_here
